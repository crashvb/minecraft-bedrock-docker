#!/bin/bash

set -e -o pipefail

source /etc/profile
source /usr/local/lib/entrypoint.sh

minecraft_config="${MINECRAFT_CONFIG:?MINECRAFT_CONFIG is required}"
minecraft_stun="${MINECRAFT_STUN:?MINECRAFT_STUN is required}"
minecraft_udp_map="${MINECRAFT_UDP_MAP:?MINECRAFT_UDP_MAP is required}"
properties="${minecraft_config}/server.properties"

function is_ipv4() {
	local address="${1}"
	local octet
	local octets

	[[ "${address}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
	IFS=. read -r -a octets <<< "${address}"
	for octet in "${octets[@]}" ; do
		((10#${octet} <= 255)) || return 1
	done
}

if [[ ! -f "${properties}" ]] ; then
	log "ERROR: Missing: ${properties}"
	exit 1
fi

current_ip="$(
	sed --quiet --regexp-extended \
		's/^server-udp-ports=(([0-9]{1,3}\.){3}[0-9]{1,3}):.*$/\1/p' \
		"${properties}" | sed --quiet '1p'
)"
if ! is_ipv4 "${current_ip}" ; then
	log "ERROR: Unable to parse the current server-udp-ports IP from: ${properties}"
	exit 1
fi

if [[ ! "${minecraft_stun}" =~ ^[^:]+:[0-9]+$ ]] ; then
	log "ERROR: Invalid MINECRAFT_STUN: ${minecraft_stun}"
	exit 1
fi
stun_host="${minecraft_stun%:*}"
stun_port="${minecraft_stun##*:}"

if [[ ! "${minecraft_udp_map}" =~ ^[0-9]+(-[0-9]+)?:[0-9]+(-[0-9]+)?$ ]] ; then
	log "ERROR: Invalid MINECRAFT_UDP_MAP: ${minecraft_udp_map}"
	exit 1
fi

if ! stun_output="$(turnutils_stunclient -p "${stun_port}" "${stun_host}" 2>&1)" ; then
	log "ERROR: Unable to query STUN server: ${minecraft_stun}"
	exit 1
fi
stun_ip="$(
	printf '%s\n' "${stun_output}" | awk '
		!found && /IPv4\. UDP reflexive addr:/ {
			address = $NF
			sub(/:[0-9]+$/, "", address)
			print address
			found = 1
		}
	'
)"
if ! is_ipv4 "${stun_ip}" ; then
	log "ERROR: Unable to parse the public IPv4 address from STUN server: ${minecraft_stun}"
	exit 1
fi

if [[ "${current_ip}" == "${stun_ip}" ]] ; then
	exit 0
fi

log "Updating server-udp-ports IP: ${current_ip} -> ${stun_ip}"
sed --in-place --regexp-extended \
	"s|^server-udp-ports=.*$|server-udp-ports=${stun_ip}:${minecraft_udp_map}|" \
	"${properties}"
